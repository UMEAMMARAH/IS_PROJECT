# SecureVault Environment Configuration Example
# Copy this file to .env and configure values for your environment

FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Security: Set a long, cryptographically random secret key in production
SECRET_KEY=dev-vault-secret-key-change-in-production-3f8a912e84c172b5

# Database URL (defaults to SQLite database/app.db)
DATABASE_URL=sqlite:///database/app.db

# Set to True only when running over HTTPS in production
SESSION_COOKIE_SECURE=False
